# Marionette editor conventions. See AGENTS.md — files carry CRLF line
# endings (CJK comments + MSVC); do not set end_of_line here or the whole
# tree churns on the next save.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_size = 4

[*.bat]
indent_style = space
indent_size = 2
