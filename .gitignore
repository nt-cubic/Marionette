# --- Dependencies / build output ---
node_modules/
dist/
dist-portable/
release/
target/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.log
*.tmp

# --- Secrets ---
.env
.env.*

# --- Runtime state written into the repo root ---
# Marionette's own project state: sessions, transcripts, handoff
.marionette/
# Legacy AgentShell state, migrated to .marionette on first start (app_paths.rs)
.agentshell/
# Claude Code CLI: the session registry holds a peer token, and the config
# backup is a copy of ~/.claude.json
.claude/
# ZCode CLI workspace state (plans etc.) -- local session scratch, not source
.zcode/
/sessions/
/backups/

# --- Local tools / external forks ---
# Drop a UPX binary here for build-portable.bat; never commit it
tools/upx.exe
# Generated by tools\build-portable.bat --engine (gzip artifact + VERSION
# stamp for include_bytes!); the SOURCE lives in third_party/magpie.
src-tauri/engine-embedded/
tools/upx/
_research/repos/

# --- Local scratch ---
# Verification harnesses / diagnostics written while checking a change
fortest/
# One-off build wrapper, agent diagnostics, browser-preview transcript
/build-now.ps1
/zdiag*.ps1
/zdiag*.txt
/preview-transcript*.jsonl
