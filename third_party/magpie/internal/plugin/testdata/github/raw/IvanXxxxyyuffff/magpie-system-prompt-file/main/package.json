{
  "name": "magpie-system-prompt-file",
  "version": "0.3.0",
  "description": "Magpie plugin: a system prompt (persona) loaded from a local .md / .txt file and injected into every agent request. macOS + Windows.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "gateway-hook",
    "system-prompt",
    "persona",
    "prompt",
    "md",
    "txt",
    "claude",
    "codex",
    "gemini"
  ],
  "magpie": {
    "hooks": "./system-prompt.hooks.mjs",
    "options": {
      "prompt_file": "~/.config/magpie/prompts/system.md",
      "prompt_files": [],
      "system_prompt": "",
      "override": true,
      "position": "append",
      "agents": [],
      "models": [],
      "strip_frontmatter": true,
      "gatewayTimeoutMs": 3000
    }
  }
}
